{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  // Setting plugins replaces the default set, so eslint (the core rules) is listed too.
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error",
    // Unstable rules that change between releases.
    "nursery": "off"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
    // Only oxlint's own directives exist here, and the toolchain test bans those too.
    "respectEslintDisableDirectives": false
  },
  "rules": {
    "typescript/ban-ts-comment": [
      "error",
      { "ts-check": true, "ts-expect-error": true, "ts-ignore": true, "ts-nocheck": true }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/strict-boolean-expressions": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "eslint/no-void": ["error", { "allowAsStatement": true }],
    "eslint/one-var": ["error", "never"],
    // Named exports only (import/no-default-export), so these two can't hold.
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    // oxfmt's sortImports orders imports by module path; this rule sorts by local name and would fight it.
    "eslint/sort-imports": "off",
    // async/await is the readable way to sequence fetches; the promise rules above guard its misuse.
    "oxc/no-async-await": "off",
    // The target is ES2024, and ?. is the null-safe access strict null checks call for.
    "oxc/no-optional-chaining": "off",
    // A single ternary is idiomatic; no-nested-ternary still bans the unreadable case.
    "eslint/no-ternary": "off",
    // DOM and fetch types (elements, events, RequestInit) are mutable by design, so every handler fails it.
    "typescript/prefer-readonly-parameter-types": "off",
    // Key order carries meaning (fetch's method/headers/body, config grouped by topic); sorting prevents no bug.
    "eslint/sort-keys": "off",
    // typescript/require-await replaces it and accepts an async function that returns a promise explicitly.
    "eslint/require-await": "off",
    // TypeScript models absence as undefined (optional properties, Map.get, find); unicorn/no-null bans the alternative.
    "eslint/no-undefined": "off",
    // 0, 1 and -1 are identities, not magic values.
    "eslint/no-magic-numbers": ["error", { "ignore": [-1, 0, 1] }],
    // Object spread is native at the ES2024 target, and eslint/prefer-object-spread asks for it.
    "oxc/no-rest-spread-properties": "off"
  },
  "overrides": [
    {
      "files": ["vite.config.ts", "vitest.config.ts", "vitest.global-setup.ts"],
      "rules": {
        // Vite and Vitest read their config from the default export.
        "import/no-default-export": "off",
        // Build and test setup run in Node, not the browser, and read the file system.
        "import/no-nodejs-modules": "off"
      }
    },
    {
      "files": ["**/*.test.ts"],
      "plugins": ["vitest"],
      "rules": {
        // Tests import describe/it/expect explicitly, so no global test types are needed (tsconfig "types": []).
        "vitest/no-importing-vitest-globals": "off",
        // Vitest's default 5 s timeout applies to every test.
        "vitest/require-test-timeout": "off",
        // Every assertion is awaited in the test body, so counting them duplicates the test.
        "vitest/prefer-expect-assertions": "off",
        // Literal inputs and expected values are what a test checks; naming each one hides it.
        "eslint/no-magic-numbers": "off",
        // Fakes resolve at once: promise-function-async plus require-await leave `async () => Promise.resolve(x)`.
        "unicorn/no-useless-promise-resolve-reject": "off"
      }
    }
  ]
}
